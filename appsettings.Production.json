{
  "Workflow": {
    "Repository": "https://github.com/ennakili/Charles-Schwab-Assessment.git",
    "PullRequestBase": "main",
    "Reviewers": [],
    "TeamReviewers": [],
    "Labels": ["agentic-workflow", "environment-production"],
    "RequiredChecks": ["build-and-test"],
    "EnableMergeQueue": false,
    "MergeQueueName": "default",
    "ApiKey": ""
  },
  "RateLimiting": {
    "ShortUrlCreate": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Redirect": { "PermitLimit": 60, "WindowSeconds": 60 }
  },
  "Abuse": {
    "BlockedHosts": ["metadata.google.internal"]
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  }
}